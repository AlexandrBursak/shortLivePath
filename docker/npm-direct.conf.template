# Entire Proxy Host Advanced field; NO Custom Locations. See docs/npm-direct.md.
# This does not erase NPM's earlier generated server-level error_log: release gate!
access_log off;
client_max_body_size 0;
client_body_timeout 10s;
send_timeout 10s;
proxy_request_buffering off;
proxy_cache off;
proxy_store off;
proxy_buffering off;
proxy_max_temp_file_size 0;
proxy_next_upstream off;
proxy_connect_timeout 2s;
proxy_read_timeout 35s;
proxy_send_timeout 10s;

location ^~ /health {
    access_log off;
    error_log /dev/null;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    return 404;
}
location ^~ /api/ {
    access_log off;
    error_log /dev/null;
    proxy_hide_header Cache-Control;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Content-Security-Policy;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $realip_remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_pass http://@UPSTREAM@:@API_PORT@;
}
location / {
    access_log off;
    error_log /dev/null;
    proxy_hide_header Cache-Control;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Content-Security-Policy;
    # Evaluated at response time: preserve Next's exact nonce policy, not a map/set.
    add_header Content-Security-Policy $upstream_http_content_security_policy always;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $realip_remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @slp_unavailable;
    proxy_pass http://@UPSTREAM@:@WEB_PORT@;
}
location @slp_unavailable {
    access_log off;
    error_log /dev/null;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    return 503;
}
