{
  "global": {
    "scrape_interval": "10s",
    "evaluation_interval": "10s"
  },
  "rule_files": [
    "/etc/prometheus/alerts.json"
  ],
  "scrape_configs": [
    {
      "job_name": "slp-aggregates",
      "static_configs": [
        {
          "targets": [
            "otel:9464"
          ]
        }
      ],
      "metric_relabel_configs": [
        {
          "source_labels": [
            "__name__"
          ],
          "action": "keep",
          "regex": "slp_.+"
        },
        {
          "action": "labelkeep",
          "regex": "__name__|operation|outcome|le"
        }
      ]
    }
  ]
}
