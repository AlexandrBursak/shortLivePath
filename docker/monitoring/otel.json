{
  "receivers": {
    "prometheus": {
      "config": {
        "scrape_configs": [
          {
            "job_name": "slp-private",
            "scrape_interval": "10s",
            "scrape_timeout": "3s",
            "metrics_path": "/health/metrics",
            "static_configs": [
              {
                "targets": [
                  "api:3333"
                ]
              }
            ],
            "metric_relabel_configs": [
              {
                "action": "labelkeep",
                "regex": "__name__|operation|outcome|le"
              }
            ]
          }
        ]
      }
    }
  },
  "exporters": {
    "prometheus": {
      "endpoint": "0.0.0.0:9464",
      "resource_to_telemetry_conversion": {
        "enabled": false
      }
    }
  },
  "service": {
    "telemetry": {
      "logs": {
        "level": "error"
      },
      "metrics": {
        "level": "none"
      }
    },
    "pipelines": {
      "metrics": {
        "receivers": [
          "prometheus"
        ],
        "exporters": [
          "prometheus"
        ]
      }
    }
  }
}
