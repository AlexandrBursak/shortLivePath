{
  "name": "short-live-path-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.17.0",
    "pnpm": "11.5.2"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "smoke": "pnpm test:integration",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "node ace.js build",
    "benchmark:reading-code": "sh ../scripts/benchmark/run.sh",
    "start": "node build/bin/server.js"
  },
  "imports": {
    "#start/*": "./start/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js"
  },
  "dependencies": {
    "@adonisjs/core": "7.6.0",
    "@adonisjs/lucid": "22.4.2",
    "argon2": "0.45.1",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.6.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@poppinss/ts-exec": "1.5.1",
    "@swc/core": "1.16.20",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
